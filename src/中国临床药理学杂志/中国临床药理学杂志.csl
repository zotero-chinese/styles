<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="never" name-as-sort-order="all" sort-separator=" " initialize-with=" " page-range-format="expanded">
  <info>
    <title>中国临床药理学杂志</title>
    <id>http://www.zotero.org/styles/中国临床药理学杂志</id>
    <link href="http://www.zotero.org/styles/中国临床药理学杂志" rel="self"/>
    <link href="https://d.wanfangdata.com.cn/periodical/zglcylxzz202401035" rel="documentation"/>
    <author>
      <name>SimonZhou</name>
      <email>pumc.zhou@outlook.com</email>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>1001-6821</issn>
    <summary>中国药学会《中国临床药理学杂志》投稿须知（2024-01-17）及编辑部审稿返修参考文献要求，基于 GB/T 7714—2025。4名及以上作者列前3名；中文加“等”，英文加斜体“et al.”；英文期刊名缩写、斜体；页码范围使用全角破折号；缺卷、期或页码的期刊文章按[J/OL]著录并显示发布日期、引用日期和URL；网络文献按[EB/OL]著录并显示发布日期、引用日期和URL</summary>
    <updated>2026-08-15T18:47:24+08:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="edition" form="short"> ed.</term>
      <term name="volume" form="short">v.</term>
      <term name="et-al">et al.</term>
    </terms>
  </locale>
  <locale xml:lang="zh">
    <terms>
      <term name="edition" form="short">版</term>
      <term name="version" form="short">v.</term>
      <term name="et-al">等</term>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">‘</term>
      <term name="close-inner-quote">’</term>
    </terms>
  </locale>
  <locale>
    <date form="numeric">
      <date-part name="year" range-delimiter="/"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/>
    </date>
    <terms>
      <term name="page-range-delimiter">&#8212;</term>
    </terms>
  </locale>
  <!-- 主要责任者 -->
  <!-- 中英文作者分别处理，以控制分隔符和 et al. 的斜体。 -->
  <!-- 英文作者 -->
  <macro name="author-en">
    <names variable="author">
      <name delimiter="， " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="composer">
          <name delimiter="， " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <names variable="illustrator">
          <name delimiter="， " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <names variable="director">
          <name delimiter="， " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <names variable="host">
          <name delimiter="， " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <choose>
          <if variable="container-title" match="none">
            <names variable="editor">
              <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
                <name-part name="family" text-case="uppercase"/>
              </name>
            </names>
            <names variable="editorial-director">
              <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
                <name-part name="family" text-case="uppercase"/>
              </name>
            </names>
            <names variable="compiler">
              <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
                <name-part name="family" text-case="uppercase"/>
              </name>
            </names>
            <names variable="collection-editor">
              <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
                <name-part name="family" text-case="uppercase"/>
              </name>
            </names>
          </if>
        </choose>
      </substitute>
    </names>
  </macro>
  <!-- 中文作者 -->
  <macro name="author-zh">
    <names variable="author">
      <name delimiter="，" delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al/>
      <substitute>
        <names variable="composer">
          <name delimiter="，" delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al/>
        </names>
        <names variable="illustrator">
          <name delimiter="，" delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al/>
        </names>
        <names variable="director">
          <name delimiter="，" delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al/>
        </names>
        <names variable="host">
          <name delimiter="，" delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=" ">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al/>
        </names>
        <choose>
          <if variable="container-title" match="none">
            <names variable="editor"/>
            <names variable="editorial-director"/>
            <names variable="compiler"/>
            <names variable="collection-editor"/>
          </if>
        </choose>
      </substitute>
    </names>
  </macro>
  <!-- 文献类型标识。 -->
  <macro name="entry-type-id">
    <choose>
      <if type="article"><text value="PP"/></if>
      <else-if type="article-journal article-magazine periodical" match="any"><text value="J"/></else-if>
      <else-if type="article-newspaper"><text value="N"/></else-if>
      <else-if type="book chapter classic entry-dictionary entry-encyclopedia" match="any"><text value="M"/></else-if>
      <else-if type="collection manuscript personal_communication" match="any"><text value="A"/></else-if>
      <else-if type="dataset"><text value="DS"/></else-if>
      <else-if type="map"><text value="CM"/></else-if>
      <else-if type="paper-conference"><text value="C"/></else-if>
      <else-if type="patent"><text value="P"/></else-if>
      <else-if type="post post-weblog webpage" match="any"><text value="EB"/></else-if>
      <else-if type="report"><text value="R"/></else-if>
      <else-if type="software"><text value="CP"/></else-if>
      <else-if type="standard"><text value="S"/></else-if>
      <else-if type="thesis"><text value="D"/></else-if>
      <else-if variable="archive"><text value="A"/></else-if>
      <else-if variable="DOI URL" match="any"><text value="EB"/></else-if>
      <else><text value="Z"/></else>
    </choose>
  </macro>
  <!-- 缺卷、期或页码时为期刊文章追加 OL。 -->
  <macro name="entry-medium-id">
    <choose>
      <if type="article-journal article-magazine" match="any">
        <choose>
          <if variable="volume" match="none"><text value="OL"/></if>
          <else-if variable="issue" match="none"><text value="OL"/></else-if>
          <else-if variable="page" match="none"><text value="OL"/></else-if>
        </choose>
      </if>
      <else-if type="article-newspaper"/>
      <else-if variable="medium"><text variable="medium"/></else-if>
      <else-if variable="URL DOI" match="any"><text value="OL"/></else-if>
    </choose>
  </macro>

  <macro name="number">
    <choose>
      <if type="patent" variable="call-number" match="all"><text variable="call-number"/></if>
      <else-if variable="number"><text variable="number"/></else-if>
      <else-if type="collection manuscript personal_communication" variable="archive" match="any"><text variable="archive_location"/></else-if>
    </choose>
  </macro>

  <macro name="volume">
    <choose>
      <if type="article article-journal article-magazine article-newspaper periodical" match="none">
        <choose>
          <if is-numeric="volume">
            <label variable="volume" form="short"/>
            <text variable="volume"/>
          </if>
          <else><text variable="volume"/></else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- 中英文题名分别处理：英文题名与 [J] 之间留空格，中文不留空格。 -->
  <macro name="title-en">
    <group delimiter=". ">
      <group delimiter="：">
        <text variable="title"/>
        <choose>
          <if variable="container-title" type="chapter entry-dictionary entry-encyclopedia paper-conference" match="none">
            <group delimiter="&#8195;"><text macro="volume"/><text variable="volume-title"/></group>
          </if>
        </choose>
        <choose>
          <if type="article article-journal standard" match="none"><text macro="number"/></if>
        </choose>
      </group>
      <choose><if type="map"><text variable="scale"/></if></choose>
    </group>
    <group delimiter="/" prefix=" [" suffix="]"><text macro="entry-type-id"/><text macro="entry-medium-id"/></group>
  </macro>

  <macro name="title-zh">
    <group delimiter=". ">
      <group delimiter="：">
        <text variable="title"/>
        <choose>
          <if variable="container-title" type="chapter entry-dictionary entry-encyclopedia paper-conference" match="none">
            <group delimiter="&#8195;"><text macro="volume"/><text variable="volume-title"/></group>
          </if>
        </choose>
        <choose>
          <if type="article article-journal standard" match="none"><text macro="number"/></if>
        </choose>
      </group>
      <choose><if type="map"><text variable="scale"/></if></choose>
    </group>
    <group delimiter="/" prefix="[" suffix="]"><text macro="entry-type-id"/><text macro="entry-medium-id"/></group>
  </macro>

  <macro name="secondary-contributors">
    <names variable="translator"><name delimiter="，"/><label form="short" prefix="，"/></names>
  </macro>

  <macro name="container-contributors">
    <names variable="container-author">
      <name delimiter="，"/>
      <substitute>
        <names variable="editor"/>
        <names variable="editorial-director"/>
        <names variable="compiler"/>
        <names variable="collection-editor"/>
      </substitute>
    </names>
  </macro>

  <macro name="container-booklike">
    <choose>
      <if variable="container-title">
        <group delimiter=". ">
          <text macro="container-contributors"/>
          <group delimiter="："><text variable="container-title"/><text macro="volume"/></group>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="journal-year">
    <choose>
      <if variable="issued"><date variable="issued" form="numeric" date-parts="year"/></if>
      <else><date variable="available-date" form="numeric" date-parts="year"/></else>
    </choose>
  </macro>
  <!-- 英文期刊名斜体。 -->
  <macro name="container-periodical-en">
    <choose>
      <if type="article-newspaper">
        <group delimiter="，"><text variable="container-title" form="short" strip-periods="true" font-style="italic"/><text macro="date"/></group>
        <text variable="page" prefix="（" suffix="）"/>
      </if>
      <else>
        <group delimiter="：">
          <group>
            <group delimiter="，">
              <text variable="container-title" form="short" strip-periods="true" font-style="italic"/>
              <text macro="journal-year"/>
              <text variable="volume"/>
            </group>
            <text variable="issue" prefix="（" suffix="）"/>
          </group>
          <choose><if variable="page"><text variable="page"/></if><else><text variable="number"/></else></choose>
        </group>
      </else>
    </choose>
  </macro>
  <!-- 中文期刊名不斜体。 -->
  <macro name="container-periodical-zh">
    <choose>
      <if type="article-newspaper">
        <group delimiter="，"><text variable="container-title" form="short" strip-periods="true"/><text macro="date"/></group>
        <text variable="page" prefix="（" suffix="）"/>
      </if>
      <else>
        <group delimiter="：">
          <group>
            <group delimiter="，">
              <text variable="container-title" form="short" strip-periods="true"/>
              <text macro="journal-year"/>
              <text variable="volume"/>
            </group>
            <text variable="issue" prefix="（" suffix="）"/>
          </group>
          <choose><if variable="page"><text variable="page"/></if><else><text variable="number"/></else></choose>
        </group>
      </else>
    </choose>
  </macro>
  <!-- 电子期刊附加信息：发布日期 [引用日期]. URL。 -->
  <macro name="online-details">
    <group delimiter=". ">
      <group delimiter=" ">
        <choose>
          <if variable="available-date"><date variable="available-date" form="numeric"/></if>
          <else><date variable="issued" form="numeric"/></else>
        </choose>
        <date variable="accessed" form="numeric" prefix="[" suffix="]"/>
      </group>
      <text variable="URL"/>
    </group>
  </macro>

  <macro name="electronic-journal-details">
    <choose>
      <if variable="volume" match="none"><text macro="online-details"/></if>
      <else-if variable="issue" match="none"><text macro="online-details"/></else-if>
      <else-if variable="page" match="none"><text macro="online-details"/></else-if>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition"><group delimiter=""><number variable="edition" form="ordinal"/><label variable="edition" form="short"/></group></if>
      <else><text variable="edition"/></else>
    </choose>
  </macro>

  <macro name="version">
    <label variable="version" form="short" text-case="capitalize-first" strip-periods="true"/>
    <text variable="version"/>
  </macro>

  <macro name="date">
    <choose>
      <if variable="issued">
        <choose>
          <if type="report" variable="publisher" match="all"><date variable="issued"><date-part name="year" range-delimiter="&#8212;"/></date></if>
          <else-if type="article-newspaper collection patent manuscript personal_communication report" variable="archive" match="any"><date variable="issued" form="numeric"/></else-if>
          <else><date variable="issued"><date-part name="year" range-delimiter="&#8212;"/></date></else>
        </choose>
      </if>
      <else-if variable="accessed"><date variable="accessed" prefix="[" suffix="]"><date-part name="year" range-delimiter="&#8212;"/></date></else-if>
    </choose>
  </macro>

  <macro name="publisher">
    <choose>
      <if type="article dataset" match="any"><text variable="publisher"/></if>
      <else-if type="book chapter classic entry-dictionary entry-encyclopedia map paper-conference periodical thesis" variable="publisher" match="any">
        <group delimiter="：">
          <group delimiter="，"><group delimiter="："><text variable="publisher-place"/><text variable="publisher"/></group><text macro="date"/></group>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="patent report" match="any"><group delimiter="："><text macro="date"/><text variable="page"/></group></else-if>
      <else-if type="collection manuscript personal_communication" variable="archive" match="any">
        <group delimiter="，"><group delimiter="："><text variable="archive-place"/><text variable="archive"/></group><text macro="date"/></group>
      </else-if>
      <else-if type="post post-weblog webpage" variable="DOI URL" match="none">
        <group delimiter="："><group delimiter="，"><group delimiter="："><text variable="publisher-place"/><text variable="publisher"/></group><text macro="date"/></group><text variable="page"/></group>
      </else-if>
    </choose>
  </macro>

  <macro name="creation-accessed-date">
    <date variable="issued" form="numeric"/>
    <date variable="accessed" form="numeric" prefix="[" suffix="]"/>
  </macro>

  <macro name="access">
    <choose><if variable="URL"><text variable="URL"/></if><else><text variable="DOI" prefix="DOI:"/></else></choose>
  </macro>

  <macro name="dimensions"><choose><if type="map"><text variable="dimensions"/></if></choose></macro>
  <!-- 英文条目。英文题名原样输出，以保留 Zotero 元数据中冒号后的大写。 -->
  <macro name="entry-layout-en">
    <group delimiter=". ">
      <choose><if type="standard" match="none"><text macro="author-en"/></if></choose>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="title-en"/>
          <text macro="secondary-contributors"/>
          <text macro="container-periodical-en"/>
          <text macro="electronic-journal-details"/>
        </if>
        <else-if type="post post-weblog webpage" match="any"><text macro="title-en"/><text macro="creation-accessed-date"/><text macro="access"/></else-if>
        <else-if type="chapter entry-dictionary entry-encyclopedia" variable="container-title" match="any">
          <group delimiter="//"><group delimiter=". "><text macro="title-en"/><text macro="secondary-contributors"/></group><text macro="container-booklike"/></group>
          <text macro="edition"/><text macro="publisher"/>
        </else-if>
        <else-if type="periodical"><text macro="title-en"/><text variable="volume"/><text macro="publisher"/></else-if>
        <else-if type="paper-conference">
          <group delimiter="//"><text macro="title-en"/><group delimiter="："><group delimiter="，"><text variable="event-title"/><text macro="date"/></group><text variable="page"/></group></group>
        </else-if>
        <else-if type="standard"><group delimiter="&#8195;"><text variable="number"/><text macro="title-en"/></group></else-if>
        <else-if type="article dataset" match="any"><text macro="title-en"/><text macro="version"/><text macro="publisher"/><text macro="creation-accessed-date"/><text macro="access"/></else-if>
        <else-if type="book classic map patent report" variable="publisher" match="any"><text macro="title-en"/><text macro="secondary-contributors"/><text macro="edition"/><text macro="publisher"/><text macro="dimensions"/></else-if>
        <else-if type="collection manuscript personal_communication" variable="archive" match="any"><text macro="title-en"/><text macro="publisher"/></else-if>
        <else-if variable="DOI URL" match="any"><text macro="title-en"/><text macro="version"/><text macro="creation-accessed-date"/><text macro="access"/></else-if>
        <else><text macro="title-en"/><text macro="secondary-contributors"/><text macro="edition"/><text macro="publisher"/></else>
      </choose>
    </group>
  </macro>
  <!-- 中文条目。 -->
  <macro name="entry-layout-zh">
    <group delimiter=". ">
      <choose><if type="standard" match="none"><text macro="author-zh"/></if></choose>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="title-zh"/>
          <text macro="secondary-contributors"/>
          <text macro="container-periodical-zh"/>
          <text macro="electronic-journal-details"/>
        </if>
        <else-if type="post post-weblog webpage" match="any"><text macro="title-zh"/><text macro="creation-accessed-date"/><text macro="access"/></else-if>
        <else-if type="chapter entry-dictionary entry-encyclopedia" variable="container-title" match="any">
          <group delimiter="//"><group delimiter=". "><text macro="title-zh"/><text macro="secondary-contributors"/></group><text macro="container-booklike"/></group>
          <text macro="edition"/><text macro="publisher"/>
        </else-if>
        <else-if type="periodical"><text macro="title-zh"/><text variable="volume"/><text macro="publisher"/></else-if>
        <else-if type="paper-conference">
          <group delimiter="//"><text macro="title-zh"/><group delimiter="："><group delimiter="，"><text variable="event-title"/><text macro="date"/></group><text variable="page"/></group></group>
        </else-if>
        <else-if type="standard"><group delimiter="&#8195;"><text variable="number"/><text macro="title-zh"/></group></else-if>
        <else-if type="article dataset" match="any"><text macro="title-zh"/><text macro="version"/><text macro="publisher"/><text macro="creation-accessed-date"/><text macro="access"/></else-if>
        <else-if type="book classic map patent report" variable="publisher" match="any"><text macro="title-zh"/><text macro="secondary-contributors"/><text macro="edition"/><text macro="publisher"/><text macro="dimensions"/></else-if>
        <else-if type="collection manuscript personal_communication" variable="archive" match="any"><text macro="title-zh"/><text macro="publisher"/></else-if>
        <else-if variable="DOI URL" match="any"><text macro="title-zh"/><text macro="version"/><text macro="creation-accessed-date"/><text macro="access"/></else-if>
        <else>
          <text macro="title-zh"/>
          <text macro="secondary-contributors"/>
          <text macro="edition"/>
          <text macro="publisher"/>
        </else>
      </choose>
    </group>
  </macro>

  <citation collapse="citation-number" after-collapse-delimiter=",">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter="," prefix="[" suffix="]" vertical-align="sup"><text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="4" et-al-use-first="3" entry-spacing="0" second-field-align="flush">
    <layout locale="zh">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="entry-layout-zh" suffix="."/>
    </layout>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="entry-layout-en" suffix="."/>
    </layout>
  </bibliography>
</style>
