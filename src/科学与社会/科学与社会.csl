<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" name-as-sort-order="all" sort-separator=" " demote-non-dropping-particle="never" initialize-with=" " initialize-with-hyphen="false" page-range-format="expanded" default-locale="zh-CN">
  <info>
    <title>科学与社会</title>
    <id>https://zotero-chinese.com/styles/科学与社会</id>
    <link href="https://zotero-chinese.com/styles/科学与社会" rel="self"/>
    <link href="https://zotero-chinese.com/styles/GB-T-7714—2015（顺序编码，双语）" rel="template"/>
    <link href="https://kxsy.cbpt.cnki.net/wkg/WebPublication/wkList.aspx?navigationID=1c8301ae-e7e3-4213-af6d-7401fedd8bf0&amp;mid=kxsy" rel="documentation"/>
    <author>
      <name>杨家风子</name>
      <email>denghanqing@whu.edu.cn</email>
    </author>
    <contributor>
      <name>牛耕田</name>
      <email>buffalo_d@163.com</email>
    </contributor>
    <contributor>
      <name>Zeping Lee</name>
      <email>zepinglee@gmail.com</email>
    </contributor>
    <category citation-format="numeric"/>
    <category field="social_science"/>
    <issn>2095-1949</issn>
    <summary>《科学与社会》文章格式规范（编辑部格式模板，未标注发布日期）。顺序编码制：正文上标 [n]，同一文献多次引用时页码标注于序号方括号之外（如 [2]1194），文末按引用顺序编号；文末参考文献 12 类（期刊/报纸/网页/图书/析出/翻译/专利/学位论文/论文集/科技报告/网络首发/预印本），不带文献类型标识，著者最多 3 人后加“, 等”或“, et al.”，英文著者姓前名后、缩写名无点、姓全大写，期刊卷（期）与报纸版次应填尽填，页码连接号用 en dash；档案文献改脚注罗列（CSL 结构限制）。</summary>
    <updated>2026-08-23T19:44:34+08:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- 中文本地化：等、译、版；页码连接号 en dash；日期带前导零 -->
  <locale xml:lang="zh">
    <terms>
      <term name="translator" form="short">译</term>
      <term name="edition" form="short">版</term>
      <term name="et-al">等</term>
      <term name="page-range-delimiter">–</term>
      <term name="citation-range-delimiter">-</term>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">‘</term>
      <term name="close-inner-quote">’</term>
    </terms>
    <date form="numeric">
      <date-part name="year" range-delimiter="/"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/>
    </date>
  </locale>
  <!-- 英文本地化：et al.；页码连接号 en dash -->
  <locale>
    <terms>
      <term name="et-al">et al.</term>
      <term name="page-range-delimiter">–</term>
      <term name="citation-range-delimiter">-</term>
    </terms>
    <date form="numeric">
      <date-part name="year" range-delimiter="/"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-" range-delimiter="/"/>
    </date>
  </locale>
  <!-- 主要责任者（中文：半角“, ”；实刊例 蔡芬, 贾枭, 沈文钦；超过 3 人前 3 人 + 等；拉丁姓氏全大写） -->
  <macro name="author-zh">
    <names variable="author">
      <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <institution/>
      <substitute>
        <names variable="composer"/>
        <names variable="illustrator"/>
        <names variable="director"/>
        <choose>
          <if variable="container-title" match="none">
            <names variable="editor"/>
          </if>
        </choose>
      </substitute>
    </names>
  </macro>
  <!-- 主要责任者（英文：实刊例 GUAN J, DODGE J, WADDEN D, et al.；姓全大写、缩写名无点） -->
  <macro name="author-en">
    <names variable="author">
      <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <institution/>
      <substitute>
        <names variable="composer"/>
        <names variable="illustrator"/>
        <names variable="director"/>
        <choose>
          <if variable="container-title" match="none">
            <names variable="editor"/>
          </if>
        </choose>
      </substitute>
    </names>
  </macro>
  <!-- 题名 -->
  <macro name="title">
    <text variable="title"/>
  </macro>
  <!-- 译者（中文：杨斌, 王忠玉, 陈彦斌, 等, 译） -->
  <macro name="translator-zh">
    <names variable="translator">
      <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- 析出文献来源责任者（中文） -->
  <macro name="container-contributors-zh">
    <names variable="editor">
      <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always"/>
      <substitute>
        <names variable="container-author">
          <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always"/>
        </names>
      </substitute>
    </names>
  </macro>
  <!-- 析出文献来源责任者（英文：实刊例 FISKE S T，姓全大写） -->
  <macro name="container-contributors-en">
    <names variable="editor">
      <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <substitute>
        <names variable="container-author">
          <name delimiter=", " et-al-min="4" et-al-use-first="3" delimiter-precedes-et-al="always">
            <name-part name="family" text-case="uppercase"/>
          </name>
        </names>
      </substitute>
    </names>
  </macro>
  <!-- 出版年：无出版年不输出占位 -->
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued" form="numeric" date-parts="year"/>
      </if>
    </choose>
  </macro>
  <!-- 完整出版日期（YYYY-MM-DD，前导零经 locale date form 输出，两引擎验证可用） -->
  <macro name="issued-date">
    <date variable="issued" form="numeric"/>
  </macro>
  <!-- 引用日期 [YYYY-MM-DD] -->
  <macro name="accessed-date">
    <date variable="accessed" form="numeric" prefix="[" suffix="]"/>
  </macro>
  <!-- 期刊出处（中文）：刊名, 出版年, 卷(期): 页码（实刊例 中国高教研究, 2025(1): 75–82） -->
  <macro name="container-periodical-zh">
    <group delimiter="">
      <group delimiter=", ">
        <text variable="container-title"/>
        <text macro="issued-year"/>
      </group>
      <choose>
        <if variable="volume">
          <text variable="volume" prefix=", "/>
        </if>
      </choose>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=": "/>
    </group>
  </macro>
  <!-- 报纸出处（中文）：报名, 出版年-月-日（版次）（实刊例 科技日报, 2026-04-11（4）） -->
  <macro name="container-newspaper-zh">
    <group delimiter="">
      <group delimiter=", ">
        <text variable="container-title"/>
        <text macro="issued-date"/>
      </group>
      <choose>
        <if variable="edition">
          <text variable="edition" prefix="（" suffix="）"/>
        </if>
        <else-if variable="page">
          <text variable="page" prefix="（" suffix="）"/>
        </else-if>
      </choose>
    </group>
  </macro>
  <!-- 出版项（中文，含页码）：出版地: 出版社, 出版年: 页码 -->
  <macro name="publisher-zh">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <group delimiter=": ">
        <text macro="issued-year"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <!-- 出版项（中文，无页码，科技报告）：报告地: 报告会主办单位, 发表年 -->
  <macro name="publisher-no-page-zh">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="issued-year"/>
    </group>
  </macro>
  <!-- 期刊出处（英文）：刊名, 出版年, 卷(期): 页码（实刊例 Scientific Reports, 2023, 13(1): 14045） -->
  <macro name="container-periodical-en">
    <group delimiter="">
      <group delimiter=", ">
        <text variable="container-title" font-style="italic"/>
        <text macro="issued-year"/>
      </group>
      <choose>
        <if variable="volume">
          <text variable="volume" prefix=", "/>
        </if>
      </choose>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=": "/>
    </group>
  </macro>
  <!-- 报纸出处（英文）：报名, 出版年-月-日(版次) -->
  <macro name="container-newspaper-en">
    <group delimiter="">
      <group delimiter=", ">
        <text variable="container-title" font-style="italic"/>
        <text macro="issued-date"/>
      </group>
      <choose>
        <if variable="edition">
          <text variable="edition" prefix="(" suffix=")"/>
        </if>
        <else-if variable="page">
          <text variable="page" prefix="(" suffix=")"/>
        </else-if>
      </choose>
    </group>
  </macro>
  <!-- 出版项（英文，含页码）：出版地: 出版社, 出版年: 页码 -->
  <macro name="publisher-en">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <group delimiter=": ">
        <text macro="issued-year"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <!-- 出版项（英文，无页码） -->
  <macro name="publisher-no-page-en">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="issued-year"/>
    </group>
  </macro>
  <!-- 中文条目布局（模板 12 类 + 图书等默认；实刊例逐字对照） -->
  <macro name="entry-zh">
    <group delimiter=". ">
      <text macro="author-zh"/>
      <choose>
        <if type="article-journal article-magazine" variable="available-date URL" match="all">
          <!-- 网络首发（实刊例：篇名. URL[引用日期]，未输出刊名/首发日期） -->
          <group delimiter=". ">
            <text macro="title"/>
            <group delimiter="">
              <text variable="URL"/>
              <text macro="accessed-date"/>
            </group>
          </group>
        </if>
        <else-if type="article-journal article-magazine" match="any">
          <!-- （1）期刊类：著者. 篇名. 刊名, 出版年, 卷(期): 页码 -->
          <text macro="title"/>
          <text macro="container-periodical-zh"/>
        </else-if>
        <else-if type="article-newspaper">
          <!-- （2）报纸类：著者. 篇名. 报名, 出版年-月-日（版次） -->
          <text macro="title"/>
          <text macro="container-newspaper-zh"/>
        </else-if>
        <else-if type="article">
          <!-- 预印本（实刊例：arXiv: 2504.16770 [2026-04-29]） -->
          <group delimiter=". ">
            <text macro="title"/>
            <group delimiter="">
              <group delimiter=": ">
                <text variable="publisher"/>
                <text variable="number"/>
              </group>
              <choose>
                <if variable="accessed">
                  <text macro="accessed-date" prefix=" "/>
                </if>
                <else>
                  <text macro="issued-year" prefix=": "/>
                </else>
              </choose>
            </group>
          </group>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <!-- 网页类（实刊例：篇名. URL[引用日期]） -->
          <group delimiter=". ">
            <text macro="title"/>
            <group delimiter="">
              <text variable="URL"/>
              <text macro="accessed-date"/>
            </group>
          </group>
        </else-if>
        <else-if type="chapter entry-dictionary entry-encyclopedia" match="any">
          <!-- （5）析出文献：著者. 析出文献名//著者. 书名. 卷(册). 版次(初版除外). 出版地: 出版社, 出版年: 页码 -->
          <group delimiter=". ">
            <group delimiter="//">
              <text macro="title"/>
              <group delimiter=". ">
                <text macro="container-contributors-zh"/>
                <text variable="container-title"/>
              </group>
            </group>
            <text variable="volume"/>
            <text variable="edition"/>
            <text macro="publisher-zh"/>
          </group>
        </else-if>
        <else-if type="paper-conference">
          <!-- （9）论文集类：著者. 篇名. 论文集名. 出版地: 出版社, 出版年: 页码 -->
          <group delimiter=". ">
            <text macro="title"/>
            <choose>
              <if variable="container-title">
                <text variable="container-title"/>
              </if>
              <else>
                <text variable="event-title"/>
              </else>
            </choose>
            <text macro="publisher-zh"/>
          </group>
        </else-if>
        <else-if type="thesis">
          <!-- （8）学位论文类：著者. 篇名. 发表地: 论文发表学校, 发表年: 页码 -->
          <group delimiter=". ">
            <text macro="title"/>
            <text macro="publisher-zh"/>
          </group>
        </else-if>
        <else-if type="report">
          <!-- （10）科技报告类：著者. 篇名. 报告地: 报告会主办单位, 发表年 -->
          <group delimiter=". ">
            <text macro="title"/>
            <text macro="publisher-no-page-zh"/>
          </group>
        </else-if>
        <else-if type="patent">
          <!-- （7）专利类：专利者. 专利名称: 专利国别, 专利号. 出版年(公告或公开日期) -->
          <group delimiter=". ">
            <group delimiter=", ">
              <group delimiter=": ">
                <text macro="title"/>
                <text variable="jurisdiction"/>
              </group>
              <text variable="number"/>
            </group>
            <text macro="issued-year"/>
          </group>
        </else-if>
        <else>
          <!-- （4）普通图书/（6）翻译类：著者. 书名. 卷（册）. 版次. 译者, 译. 出版地: 出版社, 出版年: 页码 -->
          <group delimiter=". ">
            <text macro="title"/>
            <text variable="volume"/>
            <text variable="edition"/>
            <text macro="translator-zh"/>
            <text macro="publisher-zh"/>
          </group>
        </else>
      </choose>
    </group>
  </macro>
  <!-- 英文条目布局（外文期刊名、书名斜体；文章题名正体；实刊例逐字对照） -->
  <macro name="entry-en">
    <group delimiter=". ">
      <text macro="author-en"/>
      <choose>
        <if type="article-journal article-magazine" variable="available-date URL" match="all">
          <group delimiter=". ">
            <text macro="title"/>
            <group delimiter="">
              <text variable="URL"/>
              <text macro="accessed-date"/>
            </group>
          </group>
        </if>
        <else-if type="article-journal article-magazine" match="any">
          <text macro="title"/>
          <text macro="container-periodical-en"/>
        </else-if>
        <else-if type="article-newspaper">
          <text macro="title"/>
          <text macro="container-newspaper-en"/>
        </else-if>
        <else-if type="article">
          <group delimiter=". ">
            <text macro="title"/>
            <group delimiter="">
              <group delimiter=": ">
                <text variable="publisher"/>
                <text variable="number"/>
              </group>
              <choose>
                <if variable="accessed">
                  <text macro="accessed-date" prefix=" "/>
                </if>
                <else>
                  <text macro="issued-year" prefix=": "/>
                </else>
              </choose>
            </group>
          </group>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <group delimiter=". ">
            <text macro="title"/>
            <group delimiter="">
              <text variable="URL"/>
              <text macro="accessed-date"/>
            </group>
          </group>
        </else-if>
        <else-if type="chapter entry-dictionary entry-encyclopedia" match="any">
          <!-- 实刊例：Diary Methods: ...// FISKE S T. Annual Review of Psychology: Vol. 54. ... -->
          <group delimiter=". ">
            <group delimiter="// ">
              <text macro="title"/>
              <group delimiter=". ">
                <text macro="container-contributors-en"/>
                <text variable="container-title" font-style="italic"/>
              </group>
            </group>
            <text variable="volume"/>
            <text variable="edition"/>
            <text macro="publisher-en"/>
          </group>
        </else-if>
        <else-if type="paper-conference">
          <group delimiter=". ">
            <text macro="title"/>
            <choose>
              <if variable="container-title">
                <text variable="container-title" font-style="italic"/>
              </if>
              <else>
                <text variable="event-title"/>
              </else>
            </choose>
            <text macro="publisher-en"/>
          </group>
        </else-if>
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="title"/>
            <text macro="publisher-en"/>
          </group>
        </else-if>
        <else-if type="report">
          <group delimiter=". ">
            <text macro="title"/>
            <text macro="publisher-no-page-en"/>
          </group>
        </else-if>
        <else-if type="patent">
          <group delimiter=". ">
            <group delimiter=", ">
              <group delimiter=": ">
                <text macro="title"/>
                <text variable="jurisdiction"/>
              </group>
              <text variable="number"/>
            </group>
            <text macro="issued-year"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text variable="title" font-style="italic"/>
            <text variable="volume"/>
            <text variable="edition"/>
            <text macro="publisher-en"/>
          </group>
        </else>
      </choose>
    </group>
  </macro>
  <!-- 引注：正文上标 [n]；同一文献多次引用时页码标注于 [] 外（如 [2]1194）。
       CSL 限制：多文献合引 [1,3,5-8] 的单括号折叠与页码外置不能同时实现，
       这里优先页码外置，多文献输出 [1]-[3]、[1],[3]。 -->
  <citation collapse="citation-number" after-collapse-delimiter=",">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <group>
        <text variable="citation-number" prefix="[" suffix="]"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <!-- 文末参考文献表：按引用顺序编号（实刊例 [1] 后带空格），不带文献类型标识 -->
  <bibliography entry-spacing="0" et-al-min="4" et-al-use-first="3" second-field-align="flush">
    <layout locale="en">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="entry-en" suffix="."/>
    </layout>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="entry-zh" suffix="."/>
    </layout>
  </bibliography>
</style>
