<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" initialize="true" initialize-with=" " page-range-format="expanded" default-locale="en-US" default-locale-sort="zh-CN" demote-non-dropping-particle="never">
  <info>
    <title>公共管理评论</title>
    <id>https://zotero-chinese.com/styles/公共管理评论</id>
    <link href="https://zotero-chinese.com/styles/公共管理评论" rel="self"/>
    <link href="https://gogl.cbpt.cnki.net/" rel="documentation"/>
    <author>
      <name>Zhe Shen</name>
    </author>
    <category citation-format="author-date"/>
    <category field="political_science"/>
    <category field="social_science"/>
    <issn>2096-7713</issn>
    <summary>Public Management Review (Tsinghua) author-date style, GB/T 7714-2015. Revised 2026-11 per official submission guidelines (issue #716): journal no-volume punctuation, book translator/edition/pages, newspaper edition, accessed date, et-al terms.</summary>
    <updated>2026-11-10T05:00:00+08:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- Locale: English -->
  <locale xml:lang="en">
    <terms>
      <term name="page-range-delimiter">-</term>
      <!-- 模板正文示例: Davies-Jones et al. (2009) —— 逗号由多作者分隔符提供，词元本身不带逗号 -->
      <term name="et-al">et al.</term>
    </terms>
  </locale>
  <!-- Locale: Chinese -->
  <locale xml:lang="zh">
    <terms>
      <!-- 模板正文示例: 郑永光等（2016）—— 正文引注"等"前不加逗号；
           文后 3 位作者截断时由 names 分隔符提供逗号，得到"周云新, 等" -->
      <term name="et-al">&#x7B49;</term>
      <term name="and">&#x548C;</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>
  <!-- ====== Author (bibliography) ====== -->
  <!-- 姓前名后，名缩写不加点，缩写间留空格: Daily G C -->
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="compiler"/>
      </substitute>
    </names>
  </macro>
  <!-- ====== Author (in-text) ====== -->
  <!-- 正文: 丁一汇(2000) / 杨正龙和高拴柱(2016) / 郑永光等(2016) / Murphy and Winkler (1986) -->
  <macro name="author-intext">
    <names variable="author">
      <name form="short" and="text" delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="compiler"/>
      </substitute>
    </names>
  </macro>
  <!-- ====== Year ====== -->
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <!-- ====== Type label [J] [M] etc ====== -->
  <macro name="type-label">
    <choose>
      <if type="article-journal article-magazine">
        <text value="[J]"/>
      </if>
      <else-if type="book">
        <text value="[M]"/>
      </else-if>
      <else-if type="chapter">
        <text value="[M]"/>
      </else-if>
      <else-if type="paper-conference">
        <text value="[C]"/>
      </else-if>
      <else-if type="thesis">
        <text value="[D]"/>
      </else-if>
      <else-if type="report">
        <text value="[R]"/>
      </else-if>
      <else-if type="article-newspaper">
        <text value="[N]"/>
      </else-if>
      <else-if type="patent">
        <text value="[P]"/>
      </else-if>
      <else-if type="legislation standard" match="any">
        <text value="[S]"/>
      </else-if>
      <else-if type="dataset post post-weblog software webpage" match="any">
        <text value="[EB/OL]"/>
      </else-if>
      <else>
        <text value="[Z]"/>
      </else>
    </choose>
  </macro>
  <!-- ====== Title ====== -->
  <macro name="title">
    <text variable="title"/>
  </macro>
  <!-- ====== Container: journal ====== -->
  <!-- 有卷: 高原气象, 25(5) / Applied Geochemistry, 81 -->
  <!-- 无卷: 气象学报(5)（中文刊名与期号间无标点）/ Acta Meteorologica Sinica, (5)（英文刊名后保留逗号） -->
  <macro name="container-journal-zh">
    <choose>
      <if variable="volume">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <group>
            <text variable="volume"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
        </group>
      </if>
      <else>
        <group delimiter="">
          <text variable="container-title" font-style="italic"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="container-journal-en">
    <choose>
      <if variable="volume">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <group>
            <text variable="volume"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
        </group>
      </if>
      <else>
        <group delimiter="">
          <text variable="container-title" font-style="italic"/>
          <text variable="issue" prefix=", (" suffix=")"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- ====== Container: book chapter / conference ====== -->
  <macro name="container-chapter">
    <choose>
      <if variable="container-title">
        <group>
          <text value="//"/>
          <names variable="editor">
            <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", "/>
          </names>
          <text value=". "/>
          <text variable="container-title"/>
        </group>
      </if>
    </choose>
  </macro>
  <!-- ====== Publisher ====== -->
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <!-- ====== Pages ====== -->
  <macro name="pages">
    <text variable="page"/>
  </macro>
  <!-- ====== Access ====== -->
  <macro name="access">
    <choose>
      <if type="dataset post post-weblog software webpage" match="any">
        <text variable="URL"/>
      </if>
    </choose>
  </macro>
  <!-- ====== Accessed date [2026-11-09] ====== -->
  <macro name="accessed-date">
    <date variable="accessed" form="numeric" prefix="[" suffix="]"/>
  </macro>
  <!-- ====== Translator (zh: 陈生铮, 译) ====== -->
  <macro name="translator-zh">
    <names variable="translator" delimiter=", " suffix=", &#x8BD1;"/>
  </macro>
  <!-- ====== Translator (en: Chen S Z, trans.) ====== -->
  <macro name="translator-en">
    <names variable="translator" delimiter=", " suffix=", trans."/>
  </macro>
  <!-- ====== Edition ====== -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <text variable="edition"/>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- ====== Journal entry (zh layout) ====== -->
  <macro name="entry-journal-zh">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <group delimiter=": ">
        <text macro="container-journal-zh"/>
        <text macro="pages"/>
      </group>
    </group>
  </macro>
  <!-- ====== Journal entry (en layout) ====== -->
  <macro name="entry-journal-en">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <group delimiter=": ">
        <text macro="container-journal-en"/>
        <text macro="pages"/>
      </group>
    </group>
  </macro>
  <!-- ====== Book entry (zh layout): 作者. 年. 书名[M]. 译者, 译. 版次. 出版地: 出版者, 页码. ====== -->
  <macro name="entry-book-zh">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <text macro="translator-zh"/>
      <group>
        <text macro="edition"/>
        <text value="&#x7248;"/>
      </group>
    </group>
    <text macro="publisher" prefix=". "/>
    <text macro="pages" prefix=", "/>
  </macro>
  <!-- ====== Book entry (en layout) ====== -->
  <macro name="entry-book-en">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <text macro="translator-en"/>
      <group>
        <text macro="edition"/>
        <text value=" ed."/>
      </group>
    </group>
    <text macro="publisher" prefix=". "/>
    <text macro="pages" prefix=", "/>
  </macro>
  <!-- ====== Chapter entry: 作者. 年. 析出名[M]//编者. 书名. 出版地: 出版者, 页码. ====== -->
  <macro name="entry-chapter">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <text macro="container-chapter"/>
    </group>
    <text macro="publisher" prefix=". "/>
    <text macro="pages" prefix=", "/>
  </macro>
  <!-- ====== Conference entry ====== -->
  <macro name="entry-conference">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <text macro="container-chapter"/>
    </group>
    <text macro="publisher" prefix=". "/>
    <text macro="pages" prefix=", "/>
  </macro>
  <!-- ====== Web entry: 作者. 年. 题名[EB/OL]. [引用日期]. URL ====== -->
  <macro name="entry-web">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <text macro="year"/>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <text macro="accessed-date"/>
      <text macro="access"/>
    </group>
  </macro>
  <!-- ====== Newspaper entry: 作者. 出版日期(版次). 文章名[N]. 报纸名. ====== -->
  <macro name="entry-newspaper">
    <group delimiter=". ">
      <text macro="author-bib"/>
      <group>
        <date variable="issued" form="numeric"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <group>
        <text macro="title"/>
        <text macro="type-label"/>
      </group>
      <text variable="container-title"/>
    </group>
  </macro>
  <!-- ========== In-text citation ========== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
    <sort>
      <key macro="year"/>
    </sort>
    <layout delimiter="; " prefix="(" suffix=")">
      <group delimiter=", ">
        <text macro="author-intext"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>
  <!-- ========== Bibliography ========== -->
  <!-- 文后排序: 第一作者姓名(拼音)，再按年份；同年同作者由 year-suffix 区分 -->
  <bibliography et-al-min="4" et-al-use-first="3" entry-spacing="0" hanging-indent="true">
    <sort>
      <key macro="author-bib"/>
      <key macro="year"/>
    </sort>
    <!-- 中文条目版式 -->
    <layout suffix="." locale="zh">
      <choose>
        <if type="article-journal article-magazine" match="any">
          <text macro="entry-journal-zh"/>
        </if>
        <else-if type="chapter">
          <text macro="entry-chapter"/>
        </else-if>
        <else-if type="paper-conference">
          <text macro="entry-conference"/>
        </else-if>
        <else-if type="article-newspaper">
          <text macro="entry-newspaper"/>
        </else-if>
        <else-if type="dataset post post-weblog software webpage" match="any">
          <text macro="entry-web"/>
        </else-if>
        <else>
          <text macro="entry-book-zh"/>
        </else>
      </choose>
    </layout>
    <!-- 英文条目版式 -->
    <layout suffix=".">
      <choose>
        <if type="article-journal article-magazine" match="any">
          <text macro="entry-journal-en"/>
        </if>
        <else-if type="chapter">
          <text macro="entry-chapter"/>
        </else-if>
        <else-if type="paper-conference">
          <text macro="entry-conference"/>
        </else-if>
        <else-if type="article-newspaper">
          <text macro="entry-newspaper"/>
        </else-if>
        <else-if type="dataset post post-weblog software webpage" match="any">
          <text macro="entry-web"/>
        </else-if>
        <else>
          <text macro="entry-book-en"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
